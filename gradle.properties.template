# Copy to gradle.properties and fill in if you intend to publish from
# your local machine. gradle.properties is gitignored.
#
# Release publishes normally happen from CI via .github/workflows/release.yml,
# which passes these values as -P flags from GitHub secrets.

# Override the git-version-derived version when publishing
# versionOverride=0.0.0-local

# Sign artifacts with an in-memory PGP key (required for Maven Central)
# sign=true
# signingKey=<ASCII-armored private key, newlines escaped as \n>
# signingKeyPassword=<key passphrase>

# Central Portal API credentials (https://central.sonatype.com)
# centralApiUsername=
# centralApiPassword=
